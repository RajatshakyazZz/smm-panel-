rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Settings collection: read by all, write by admin
    match /settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Users collection: read/write by user themselves or admin
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
    }

    // Services & Categories: public read
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders & Transactions: user specific or admin
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }

    match /transactions/{txnId} {
      allow read, write: if request.auth != null;
    }

    // Tickets & Alerts
    match /tickets/{ticketId} {
      allow read, write: if request.auth != null;
    }

    match /alerts/{alertId} {
      allow read, write: if request.auth != null;
    }
  }
}
